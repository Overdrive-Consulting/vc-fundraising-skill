{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InvestorList",
  "description": "Array of individual investors at candidate firms, produced by map-investors",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["fund_id", "name", "title", "firm"],
    "properties": {
      "fund_id": { "type": "string", "description": "Foreign key → fund_candidates.fund_id" },
      "name": { "type": "string" },
      "title": { "type": "string" },
      "firm": { "type": "string" },
      "location": { "type": ["string", "null"] },
      "linkedin": { "type": ["string", "null"] },
      "firm_profile_url": { "type": ["string", "null"] },
      "why_relevant": { "type": ["string", "null"] }
    }
  }
}
